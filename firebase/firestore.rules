rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function uye() { return request.auth != null && exists(/databases/$(database)/documents/uyeler/$(request.auth.uid)); }
    function profil() { return get(/databases/$(database)/documents/uyeler/$(request.auth.uid)).data; }
    function yonetici() { return uye() && profil().rol == 'yonetici'; }
    function merkez() { return uye() && profil().rol != 'sube'; }
    function subem() { return profil().sube; }
    match /uyeler/{u} {
      allow read: if request.auth != null && (request.auth.uid == u || uye());
      allow create: if yonetici() || (request.auth != null && request.auth.uid == u && request.resource.data.rol == 'yonetici' && !exists(/databases/$(database)/documents/kurulum/ilk));
      allow update, delete: if yonetici();
    }
    match /kurulum/{d} {
      allow read: if true;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/kurulum/ilk);
    }
    match /ayar/{d} {
      allow read: if uye();
      allow write: if yonetici();
    }
    match /sube/{d} {
      allow read: if merkez() || (uye() && resource.data.sube == subem());
      allow create, update: if merkez() || (uye() && request.resource.data.sube == subem() && (resource == null || resource.data.sube == subem()));
      allow delete: if yonetici();
    }
    match /subedenetim/{d} {
      allow read: if merkez() || (uye() && resource.data.sube == subem());
      allow write: if merkez();
    }
    match /foto/{d} {
      allow read, write: if uye();
    }
    match /{c}/{d=**} {
      allow read, write: if merkez() && !(c in ['uyeler', 'kurulum', 'ayar', 'sube', 'subedenetim', 'foto']);
    }
  }
}
